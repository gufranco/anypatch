{
  "name": "anypatch-release-tooling",
  "version": "0.0.0-managed-by-semantic-release",
  "private": true,
  "description": "Release and formatting tooling only. The package itself is Python, installed from a release tag or through Homebrew.",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write \"**/*.{json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{json,yml,yaml}\""
  },
  "devDependencies": {
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.11",
    "prettier": "3.10.1",
    "semantic-release": "26.0.1"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  }
}
